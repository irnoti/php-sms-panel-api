{
    "name": "irnoti/php-sms-panel-api",
    "description": "Official framework-agnostic PHP SDK for the irnoti platform API (SMS, pattern, SOS, phonebook, services, verify, bots, VoIP, webhooks).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/irnoti/php-sms-panel-api",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Irnoti\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Irnoti\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "keywords": [
        "irnoti",
        "sms",
        "sms-api",
        "sdk",
        "api-client",
        "otp",
        "iran"
    ],
    "authors": [
        {
            "name": "irnoti",
            "email": "support@irnoti.com",
            "homepage": "https://irnoti.com"
        }
    ],
    "support": {
        "issues": "https://github.com/irnoti/php-sms-panel-api/issues",
        "source": "https://github.com/irnoti/php-sms-panel-api",
        "docs": "https://irnoti.com/docs"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
